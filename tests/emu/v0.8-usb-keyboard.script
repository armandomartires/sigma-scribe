# v0.8 USB keyboard (raw evdev codes through the US keymap) and export help.
# Setting on, nothing plugged: the status bar says "no USB".
tap-on Options
tap-on USB keyboard/On
tap-on Close
expect-usb off
shot v0.8-no-usb
usb plug
expect-usb on
usb-type # Trip log
usb-key enter
usb-type Left at 9:40, "rain" & wind.
expect # Trip log
expect Left at 9:40, "rain" & wind.
expect-status saved
shot v0.8-usb-typing
# Shortcuts: the S2.5 Ctrl code.
usb-key shift+left
usb-key shift+left
usb-key shift+left
usb-key shift+left
usb-key shift+left
expect-selection wind.
usb-key ctrl+c
expect-clipboard wind.
usb-key ctrl+end
usb-key enter
usb-key ctrl+v
expect-line 13
usb-key ctrl+z
usb-key ctrl+f
expect-mode find
usb-type rain
expect-find 1 of 1
shot v0.8-usb-find
usb-key esc
expect-mode write
# The on-screen keyboard still works alongside.
type ok
expect-status saved
# Scratch takes USB typing too.
tap-on Scratch
tap-on ScratchPane
usb-type jot this
expect-scratch jot this
tap-on Scratch
# Help page.
tap-on Help
tap-on USB keyboard & export
expect-help Help / USB keyboard & export
shot v0.8-help-usb
tap-on Close
# Unplug while typing: no crash, flag back to "no USB".
usb-key ctrl
usb unplug
expect-usb off
type z
expect-status saved
# Landscape.
usb plug
tap-on Options
tap-on Orientation/Landscape
tap-on Close
usb-type Sideways.
shot v0.8-landscape-usb
tap-on Options
tap-on Orientation/Portrait
tap-on USB keyboard/Off
tap-on Close
