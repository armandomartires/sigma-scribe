# v0.1 editor + on-screen keyboard (headless emulator, 1440x1920).
# Full is the default since v0.2.1; this script covers the Compact board.
key Compact
expect-status saved
shot v0.1-start
key Return
type Hello from the Forma
expect Hello from the Forma
expect-status saved
shot v0.1-typed
key 123
shot v0.1-symbols
key 1
key ABC
expect Forma1
tap 1310 1370
shot v0.1-keys-hidden
hw  (typed on a hardware keyboard)
expect hardware keyboard
